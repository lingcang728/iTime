{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iTime",
  "version": "0.2.0",
  "identifier": "com.itime.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iTime",
        "width": 1540,
        "height": 944,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "devtools": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/iTime/Cache/Icons/**/*"]
      },
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDQxNTdGNjZFOTY4RTMxMUYKUldRZk1ZNldidlpYUVU0eEZoQlFwSE84SXh5S0t1Ukg0S0xHNDUrU3Qra0trRDFWWm8wYUZxeUwK",
      "endpoints": [
        "https://github.com/lingcang728/iTime/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "本机屏幕时间与键盘输入统计",
    "longDescription": "iTime 记录本机屏幕时间、键盘输入与 AI 工具前台活动。安装后可在开始菜单搜索 iTime 直接打开。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "iTime",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
